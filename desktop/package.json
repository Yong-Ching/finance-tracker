{
  "name": "finance-desktop",
  "productName": "finance-tracker",
  "version": "1.1.0",
  "private": true,
  "description": "Desktop shell for the finance/ dashboard",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "node scripts/bake-path.js && sh scripts/make-icon.sh && electron-builder --mac --dir",
    "install-app": "npm run package && sh scripts/install.sh",
    "stage": "node scripts/stage-server.js",
    "dist": "npm run stage && sh scripts/make-icon.sh && electron-builder --mac --arm64 --x64 --config electron-builder.release.js && node scripts/zip-release.js",
    "release": "node scripts/release.js"
  },
  "build": {
    "appId": "local.finance.dashboard",
    "productName": "finance-tracker",
    "files": [
      "main.js",
      "server.js",
      "splash.html",
      "updates.js",
      "claude.js",
      "project-path.json",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dir",
      "icon": "build/icon.icns",
      "category": "public.app-category.finance",
      "identity": null
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12"
  }
}
