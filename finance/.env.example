# Optional. Without it the Claude review layer is disabled and the rest of the
# app works exactly as before - parsing, rules and reconciliation are local.
ANTHROPIC_API_KEY=

# Set to 0 to keep the API key configured but turn the review layer off.
FINANCE_AI_REVIEW=1

# Names masked out of any text sent for review. Comma-separated.
FINANCE_OWNER_NAMES=YOUR NAME,ANOTHER SPELLING
